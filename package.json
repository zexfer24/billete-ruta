{
  "name": "ticketruta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "worker:dev": "dotenv -e .env -- tsx watch src/worker/index.ts",
    "seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "db:test:up": "docker compose -f docker/docker-compose.test.yml up -d",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:test:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "mock": "dotenv -e .env -- tsx prisma/mock.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "argon2": "0.44.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "next": "15.5.4",
    "pdf-lib": "1.17.1",
    "pg-boss": "10.3.2",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "dotenv-cli": "7.4.4",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.4",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "2.1.9"
  }
}
