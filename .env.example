# Copia este archivo como .env para desarrollo y como .env.test para las pruebas de integración.

# Base de datos. Desarrollo usa el puerto 5434 y las pruebas el 5435.
DATABASE_URL="postgresql://ticketruta:ticketruta@localhost:5434/ticketruta"

# Secretos. Deben tener al menos 32 caracteres. Genera valores propios en producción.
SESSION_SECRET="cambia-este-secreto-de-sesion-32ch"
TICKET_SECRET="cambia-este-secreto-de-tickets-32c"

# Proveedor de WhatsApp: "fake" para desarrollo y pruebas, "meta" para producción.
WHATSAPP_PROVIDER="fake"

# URL pública del sistema, usada en los enlaces que se envían al pasajero.
PUBLIC_BASE_URL="http://localhost:3000"

# Carpeta donde se guardan comprobantes, documentos y tickets.
UPLOADS_DIR="./uploads"

# Zona horaria de negocio. Las horas se muestran siempre en formato de 24 horas.
TZ="America/Caracas"
